{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "<TEAMS_APP_ID>",
  "packageName": "com.contactsportal.customers",
  "developer": {
    "name": "Contacts Portal",
    "websiteUrl": "https://<PORTAL_HOST>",
    "privacyUrl": "https://<PORTAL_HOST>/privacy",
    "termsOfUseUrl": "https://<PORTAL_HOST>/terms"
  },
  "name": {
    "short": "Contacts Portal",
    "full": "Contacts Portal for Microsoft Teams"
  },
  "description": {
    "short": "Your workspace, customer tabs, and contact sharing in Teams.",
    "full": "Open your personal workspace, configure customer tabs in teams and chats, or search the Contacts Portal customer directory and share an Adaptive Card with customer details and contacts."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#FFFFFF",
  "staticTabs": [
    {
      "entityId": "contacts-portal",
      "name": "Gather",
      "contentUrl": "https://<PORTAL_HOST>/teams/tab/?provider=<TEAMS_OIDC_PROVIDER_ID>",
      "websiteUrl": "https://<PORTAL_HOST>/",
      "scopes": ["personal"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://<PORTAL_HOST>/teams/config/",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupChat"]
    }
  ],
  "composeExtensions": [
    {
      "botId": "<TEAMS_BOT_APP_ID>",
      "canUpdateConfiguration": false,
      "commands": [
        {
          "id": "searchCustomers",
          "type": "query",
          "title": "Search customers",
          "description": "Search customers by company name.",
          "context": ["compose", "commandBox"],
          "parameters": [
            {
              "name": "searchText",
              "title": "Customer name",
              "description": "Enter all or part of a customer company name."
            }
          ]
        }
      ]
    }
  ],
  "validDomains": ["<PORTAL_HOST>"],
  "webApplicationInfo": {
    "id": "<TEAMS_SSO_APP_ID>",
    "resource": "api://<PORTAL_HOST>/<TEAMS_SSO_APP_ID>"
  }
}
