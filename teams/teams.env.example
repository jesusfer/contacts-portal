# Copy to teams.env and fill in every value. No secrets are needed.
# Public HTTPS hostname only, without a scheme or trailing slash.
PORTAL_HOST=
# Teams app ID for the tabs and bot messaging extension package.
TEAMS_APP_ID=
# Teams app ID for the separate API messaging extension package.
TEAMS_API_APP_ID=
# Entra application (client) ID used for Teams SSO.
TEAMS_SSO_APP_ID=
# Azure Bot application (client) ID.
TEAMS_BOT_APP_ID=
# Configured OIDC provider ID, for example entraid-work.
TEAMS_OIDC_PROVIDER_ID=
