{
  "openapi": "3.0.1",
  "info": {
    "title": "Contacts Portal contact search",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://<PORTAL_HOST>"
    }
  ],
  "paths": {
    "/api/teams/contact-search/": {
      "get": {
        "operationId": "searchContacts",
        "summary": "Find contacts by customer name, contact name, or email.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Search words matching the customer, contact name, or email.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Matching contacts with the requesting agent's latest three call records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "contacts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "email": {
                            "type": "string"
                          },
                          "customer": {
                            "type": "string"
                          },
                          "calls": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
